# MATRU-NETRA Environment Configuration Example
# Copy this file to .env and replace the placeholders with your actual credentials.
# Do NOT commit actual secrets or service-role keys to public version control.

# 1. Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public API Key (safe to use in browser client)
VITE_SUPABASE_ANON_KEY=your-actual-anon-public-key

# Note:
# When VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are provided, MATRU-NETRA connects
# directly to your Supabase PostgreSQL database and Supabase Auth.
# If not yet configured, the application securely initializes with a local cryptographic
# authentication engine (SHA-256 password hashing and session tokens) so all role
# verification, patient registrations, and access controls function immediately.

