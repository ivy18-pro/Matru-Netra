export function rowToVisit(r: Record<string, any>): VisitRecord {
  return {
    id: r.id,
    motherId: r.mother_id,
    motherName: r.mother_name,
    visitType: r.visit_type,
    date: r.date,
    gestationalAgeWeeks: r.gestational_age_weeks,
    bpSystolic: r.bp_systolic,
    bpDiastolic: r.bp_diastolic,
    weightKg: Number(r.weight_kg),
    hemoglobin: Number(r.hemoglobin),
    fetalHeartRate: r.fetal_heart_rate ?? undefined,
    babyTempCelsius: r.baby_temp_celsius != null ? Number(r.baby_temp_celsius) : undefined,
    dangerSignsReported: r.danger_signs_reported ?? [],
    ashaObservations: r.asha_observations ?? '',
    flaggedForDoctor: !!r.flagged_for_doctor,
    flagReason: r.flag_reason ?? undefined,
    decisionSupportAlert: r.decision_support_alert ?? undefined,
    doctorReview: r.doctor_review ?? undefined,
    syncStatus: 'Synchronised',
    recordedBy: r.recorded_by_name ?? '',
    createdAt: r.created_at
  };
}

// ---------------------------------------------------------------------------
// Offline queue payload shapes
// ---------------------------------------------------------------------------
export interface RegisterMotherPayload { actorId?: string; mother: Mother }
export interface RecordVisitPayload { actorId: string; visit: VisitRecord; motherPatch: Partial<Mother> }
export interface DoctorReviewPayload {
  actorId: string; visitId: string; motherId?: string;
  review: NonNullable<VisitRecord['doctorReview']>; motherPatch?: Partial<Mother>;
}
export interface UpdateMotherPayload { actorId?: string; motherId: string; patch: Partial<Mother> }

/**
 * Overlay changes that have not reached the server yet on top of the freshly
 * downloaded shared data, so a worker never "loses" what they just entered
 * while offline, and sees it flagged as "Pending synchronisation".
 */
export function overlayPendingChanges(
  serverMothers: Mother[],
  serverVisits: VisitRecord[],
  queue: OfflineQueueItem[],
  actorId?: string
): { mothers: Mother[]; visits: VisitRecord[] } {
  let mothers = serverMothers.map((m) => ({ ...m }));
  let visits = serverVisits.map((v) => ({ ...v }));

  const mine = queue.filter((q) => {
    const a = q.payload?.actorId;
    return !a || !actorId || a === actorId;
  });

  const patchMother = (id: string, patch?: Partial<Mother>) => {
    if (!patch) return;
    mothers = mothers.map((m) => (m.id === id ? { ...m, ...patch, syncStatus: 'Pending synchronisation' } : m));
  };

  for (const item of mine) {
    switch (item.type) {
      case 'REGISTER_MOTHER': {
        const p = item.payload as RegisterMotherPayload;
        if (p?.mother && !mothers.some((m) => m.id === p.mother.id)) {
          mothers = [{ ...p.mother, syncStatus: 'Pending synchronisation' }, ...mothers];
        }
        break;
      }
      case 'RECORD_VISIT': {
        const p = item.payload as RecordVisitPayload;
        if (p?.visit && !visits.some((v) => v.id === p.visit.id)) {
          visits = [{ ...p.visit, syncStatus: 'Pending synchronisation' }, ...visits];
        }
        patchMother(p?.visit?.motherId, p?.motherPatch);
        break;
      }
      case 'DOCTOR_REVIEW': {
        const p = item.payload as DoctorReviewPayload;
        visits = visits.map((v) => (v.id === p.visitId ? { ...v, doctorReview: p.review } : v));
        if (p.motherId) patchMother(p.motherId, p.motherPatch);
        break;
      }
      case 'UPDATE_MOTHER': {
        const p = item.payload as UpdateMotherPayload;
        patchMother(p.motherId, p.patch);
        break;
      }
      default:
        break;
    }
  }
  return { mothers, visits };
}

/** Decide whether a failed upload is worth retrying later (true) or is a permanent rejection (false). */
export function isRetryableError(err: unknown): boolean {
  const e = err as { code?: string; status?: number; message?: string } | null;
  if (!e) return true;
  const status = typeof e.status === 'number' ? e.status : undefined;
  if (status !== undefined && (status >= 500 || status === 408 || status === 429 || status === 0)) return true;
  const code = (e.code || '').toString();
  if (!code) return true; // no database code => network / fetch failure
  if (code.startsWith('PGRST30')) return true; // expired / missing JWT: sign-in will refresh
  if (/^(08|53|57|58)/.test(code)) return true; // connection / resource errors
  return false; // RLS (42501), constraint, validation errors etc. will never succeed on retry
}
