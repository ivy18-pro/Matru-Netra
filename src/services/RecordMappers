  return {
    id: v.id,
    mother_id: v.motherId,
    mother_name: v.motherName,
    visit_type: v.visitType,
    date: v.date,
    gestational_age_weeks: v.gestationalAgeWeeks,
    bp_systolic: v.bpSystolic,
    bp_diastolic: v.bpDiastolic,
    weight_kg: v.weightKg,
    hemoglobin: v.hemoglobin,
    fetal_heart_rate: v.fetalHeartRate ?? null,
    baby_temp_celsius: v.babyTempCelsius ?? null,
    danger_signs_reported: v.dangerSignsReported ?? [],
    asha_observations: emptyToNull(v.ashaObservations),
    flagged_for_doctor: !!v.flaggedForDoctor,
    flag_reason: emptyToNull(v.flagReason),
    decision_support_alert: emptyToNull(v.decisionSupportAlert),
    doctor_review: v.doctorReview ?? null,
