/**
 * Pure helpers (no network, no React) that translate between the app's
 * camelCase records and the snake_case rows in the shared Supabase database,
 * and that overlay not-yet-uploaded (offline) changes on top of server data.
 */
import type { Mother, VisitRecord, OfflineQueueItem, Language, RiskLevel, RecordStatus } from '../types';

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

export const isUuid = (v: unknown): v is string => typeof v === 'string' && UUID_RE.test(v);

const uuidOrNull = (v?: string | null): string | null => (isUuid(v) ? v : null);
const emptyToNull = (v?: string | null): string | null => (v && v.trim() ? v : null);

/** Generate an id that is safe to create on a device with no internet. */
export const newRecordId = (): string => {
  if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
    return crypto.randomUUID();
  }
  // Fallback for very old browsers
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
    const r = (Math.random() * 16) | 0;
    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);
  });
};

// ---------------------------------------------------------------------------
// Mother  <->  maternal_patients
// ---------------------------------------------------------------------------
export function motherToRow(m: Mother, actorId?: string | null) {
  return {
    id: m.id,
    user_id: uuidOrNull(m.userId),
    name: m.name,
    age: m.age,
    husband_name: emptyToNull(m.husbandName),
    village: m.village,
    sub_centre: m.subCentre || 'Unassigned Sub-Centre',
    phc_name: m.phcName || 'Unassigned PHC',
    phone: m.phone,
    lmp_date: m.lmpDate,
    edd_date: m.eddDate,
    gestational_weeks: m.gestationalWeeks,
    gravida: m.gravida,
    para: m.para,
    blood_group: emptyToNull(m.bloodGroup),
    risk_level: m.riskLevel,
    risk_reasons: m.riskReasons ?? [],
    status: m.status,
    assigned_asha_id: uuidOrNull(m.assignedAshaId),
    assigned_asha_name: emptyToNull(m.assignedAshaName),
    assigned_asha_phone: emptyToNull(m.assignedAshaPhone),
    assigned_doctor_id: uuidOrNull(m.assignedDoctorId),
    assigned_doctor_name: emptyToNull(m.assignedDoctorName),
    last_visit_date: emptyToNull(m.lastVisitDate),
    next_scheduled_date: emptyToNull(m.nextScheduledDate),
    next_scheduled_type: emptyToNull(m.nextScheduledType),
    baby_details: m.babyDetails ?? null,
    preferred_language: m.preferredLanguage ?? null,
    selected_state: m.selectedState ?? null,
    selected_district: m.selectedDistrict ?? null,
    language_onboarding_completed: !!m.languageOnboardingCompleted,
    asha_assisted_onboarding: m.ashaAssistedOnboarding ?? null,
    registered_by_id: uuidOrNull(actorId)
  };
}

/** Convert a partial app-side change into a partial database update. */
export function motherPatchToRow(p: Partial<Mother>): Record<string, unknown> {
  const full = motherToRow({ ...(p as Mother) });
  const map: Record<keyof Mother, string | null> = {
    id: null, userId: null, name: 'name', age: 'age', husbandName: 'husband_name', village: 'village',
    subCentre: 'sub_centre', phcName: 'phc_name', phone: 'phone', lmpDate: 'lmp_date', eddDate: 'edd_date',
    gestationalWeeks: 'gestational_weeks', gravida: 'gravida', para: 'para', bloodGroup: 'blood_group',
    riskLevel: 'risk_level', riskReasons: 'risk_reasons', status: 'status',
    assignedAshaId: 'assigned_asha_id', assignedAshaName: 'assigned_asha_name', assignedAshaPhone: 'assigned_asha_phone',
    assignedDoctorId: 'assigned_doctor_id', assignedDoctorName: 'assigned_doctor_name',
    lastVisitDate: 'last_visit_date', nextScheduledDate: 'next_scheduled_date', nextScheduledType: 'next_scheduled_type',
    syncStatus: null, preferredLanguage: 'preferred_language', selectedState: 'selected_state',
    selectedDistrict: 'selected_district', languageOnboardingCompleted: 'language_onboarding_completed',
    ashaAssistedOnboarding: 'asha_assisted_onboarding', babyDetails: 'baby_details'
  };
  const out: Record<string, unknown> = {};
  (Object.keys(p) as (keyof Mother)[]).forEach((k) => {
    const col = map[k];
    if (col) out[col] = (full as Record<string, unknown>)[col];
  });
  return out;
}

export function rowToMother(r: Record<string, any>): Mother {
  return {
    id: r.id,
    userId: r.user_id ?? undefined,
    name: r.name,
    age: r.age,
    husbandName: r.husband_name ?? '',
    village: r.village,
    subCentre: r.sub_centre ?? '',
    phcName: r.phc_name ?? '',
    phone: r.phone,
    lmpDate: r.lmp_date,
    eddDate: r.edd_date,
    gestationalWeeks: r.gestational_weeks,
    gravida: r.gravida,
    para: r.para,
    bloodGroup: r.blood_group ?? '',
    riskLevel: (r.risk_level ?? 'normal') as RiskLevel,
    riskReasons: r.risk_reasons ?? [],
    status: (r.status ?? 'Scheduled') as RecordStatus,
    assignedAshaId: r.assigned_asha_id ?? '',
    assignedAshaName: r.assigned_asha_name ?? '',
    assignedAshaPhone: r.assigned_asha_phone ?? '',
    assignedDoctorId: r.assigned_doctor_id ?? '',
    assignedDoctorName: r.assigned_doctor_name ?? '',
    lastVisitDate: r.last_visit_date ?? undefined,
    nextScheduledDate: r.next_scheduled_date ?? '',
    nextScheduledType: r.next_scheduled_type ?? '',
    syncStatus: 'Synchronised',
    preferredLanguage: (r.preferred_language ?? undefined) as Language | undefined,
    selectedState: r.selected_state ?? undefined,
    selectedDistrict: r.selected_district ?? undefined,
    languageOnboardingCompleted: !!r.language_onboarding_completed,
    ashaAssistedOnboarding: r.asha_assisted_onboarding ?? undefined,
    babyDetails: r.baby_details ?? undefined
  };
}

